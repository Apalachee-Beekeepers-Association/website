<style>
    .eventlist {
        padding: 0;
        margin: 0;
        list-style: none;
        display: grid;
        gap: 1rem;
    }
    .eventlistitem {
        display: grid;
        border: 1px solid currentColor;
        border-radius: 0.5rem;
        overflow: clip;
    }
    .eventlistitem--media {
        aspect-ratio: 16 / 9;
        width: 100%;
        height: auto;
        object-fit: cover;
    }
    .eventlistitem--body {
        padding: 1rem;
    }

    @media (min-width: 768px) {
        .eventlist {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (min-width: 992px) {
        .eventlist {
            grid-template-columns: 1fr 1fr 1fr;
            
        }
    }
</style>
<ul class="eventlist">
{%- for event in eventlist -%}
    <li class="eventlistitem">
        <img class="eventlistitem--media" src="{{event.data.cover}}" alt="" />
        <div class="eventlistitem--body">
            <a class="eventlistitem--title" href="{{event.url}}">{{ event.data.title }}</a>
        </div>
        </li>
{%- endfor -%}
</ul>
