<style>
    .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--accent-600);
        color: var(--accent-50);
        text-decoration: none;
    }

    header {
        background-color: var(--accent-50);
        border-bottom: 1px solid var(--accent-200);
    }

    .navbar {
        max-width: var(--xl);
        padding-inline: 0.5rem;
        margin-inline: auto;
        display: flex;
        justify-content: space-between;
        align-items: stretch;
    }

    .navbar--logo {
        color: var(--foreground);
        text-decoration: none;
        padding: 0 0.5rem;
        gap: 0.5rem;
        display: flex;
        align-items: center;
        font-size: 1.25em;
    }

    .navbar--logo img,
    .navbar--logo svg {
        height: 2em;
        width: 2em;
    }

    .nav {
        list-style: none;
        display: flex;
        padding: 0;
        margin: 0;
    }

    .nav--item {
        padding: 0.5rem 0.25rem;
        font-weight: 450;
    }
    .nav--item a svg {
        height: 1em;
        width: 1em;
    }
    .nav--item a {
        transition: background-color 300ms, color 300ms;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.5rem 0.5rem;
        text-decoration: none;
        color: currentColor;
        border-radius: 0.5rem;
    }
    .nav--item a:hover {
        background-color: var(--accent-100);
        color: var(--accent-600);
    }
    .nav--item--active a {
        background-color: var(--accent-600);
        color: var(--accent-50);
    }
    .nav--item--active a:hover {
        background-color: var(--accent-500);
        color: var(--accent-50);
    }
</style>
<a href="#main" class="visually-hidden-focusable skip-link">Skip to main content</a>
<header>
    <nav class="navbar">
    <a href="/" class="navbar--logo"><img src="/logo.png" alt="" />{{ metadata.title }}</a>
    {% assign navPages = collections.all | eleventyNavigation %}
    <ul class="nav">
        {%- for entry in navPages %}
        <li class="nav--item{% if entry.url == page.url %} nav--item--active{% endif %}">
            <a href="{{ entry.url }}">{{ entry.title }}
            </a>
        </li>
        {%- endfor %}
    </ul>
    </nav>
</header>