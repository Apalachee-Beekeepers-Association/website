<!doctype html>
<html lang="{{ metadata.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {% if title %}
        {{ title }} - {{ metadata.title }}
      {% else %}
        {{ metadata.title }}
      {% endif %}
    </title>
    <meta name="description" content="{{ description or metadata.description }}">
    <meta name="generator" content="{{ eleventy.generator }}">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Montagu+Slab:opsz,wght@16..144,100..700&display=swap" rel="stylesheet">
    <style>{% getBundle "css" %}</style>
	<style>{% include 'reset.css' %}</style>
	<style>{% include 'global.css' %}</style>
  </head>

  <body>
    {% getBundle "fontawesome" %}
    <a
      href="#main"
      id="skip-link"
      class="visually-hidden-focusable skip-link">Skip to main content</a>

    <header>
      <nav class="navbar">
        <a href="/" class="navbar--logo"><i class="fa-solid fa-hexagon"></i>{{ metadata.title }}</a>
        {% assign navPages = collections.all | eleventyNavigation %}
        <ul class="nav">
          {%- for entry in navPages %}
            <li class="nav--item{% if entry.url == page.url %} nav--item--active{% endif %}">
              <a href="{{ entry.url }}">{{ entry.title }}
				{% comment %} {% if entry.url == page.url %}<i class="fa-solid fa-hexagon"></i>{% endif %} {% endcomment %}
			  </a>
            </li>
          {%- endfor %}
        </ul>
      </nav>
    </header>

    <main id="main">
      {{ content }}
    </main>

    <footer>
		<div class="footer">
			<div class="footer--address">
				<p>
				Apalachee Beekeepers Association
		  		<br>
				P.O. Box  15422
				<br>
				Tallahassee, FL 32317
				</p>
			</div>
			<p>
				<em>Built with
					<a href="https://www.11ty.dev/">{{ eleventy.generator }}</a>
				</em>
			</p>
		</div>
    </footer>

    <!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
    <script type="module" src="{% getBundleFileUrl "js" %}"></script>
  </body>

</html>