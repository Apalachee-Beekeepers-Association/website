---
title: Events
eleventyNavigation:
  key: Events
pagination:
  data: collections.events
  size: 25
calendarWebCal: webcal://aba.violetro.se/feed.ics
calendarHttps: https://aba.violetro.se/feed.ics
---
<h1>Events</h1>
<details>
  <summary>Add to your calendar</summary>
  <ul>
    <li>
      <a href="{{calendarWebCal}}">
        <i class="fa-brands fa-apple"></i>Apple Calendar</a>
    </li>
    <li>
      <a href="{{calendarWebCal}}">
        <i class="fa-brands fa-microsoft"></i>Outlook (app)</a>
    </li>
    <li>
      <a href="https://outlook.office.com/calendar/0/addfromweb?url={{calendarWebCal}}">
        <i class="fa-brands fa-microsoft"></i>Outlook (web)</a>
    </li>
    <li>
      <a href="https://calendar.google.com/calendar/r?cid={{calendarWebCal}}">
        <i class="fa-brands fa-google"></i>Google Calendar</a>
    </li>
    <li>
      <a href="https://example.com/calendar.ics">Others</a>
    </li>
    <li>
      iCal URL:
      <code style="user-select:all">{{ calendarHttps }}</code>
    </li>
  </ul>
</details>

<ul>
  {%- for event in pagination.items %}
    <li>
      <a href="{{event.url}}">{{ event.data.title }}</a>
    </li>
  {% endfor -%}
</ul>
<a href="{{pagination.href.first}}">First</a>
<a href="{{pagination.href.previous}}">Previous</a>
{%- for href in pagination.hrefs %}
  <a href="{{href}}">{{ forloop.index }}</a>
{% endfor -%}
<a href="{{pagination.href.next}}">Next</a>
<a href="{{pagination.href.last}}">Last</a>