---
hero:
  title: Intro to Beekeeping Short Course
  body: Come learn the basics of beekeeping in our fun and interactive one day course - **perfect for beginners!**
  cta: Register Now!
  link: https://www.eventbrite.com/e/2026-intro-to-beekeeping-short-course-tickets-1977574800463
  logo: /media/homepage/logo.png
  background: /media/homepage/hero-bg.jpg
eleventyNavigation:
  order: 1
  key: Home
---

<style>
  .hero--wrapper {
    position: relative;
  }
  .hero--intro {
    text-align: center;
    /* color: var(--foreground);
    background-color: #0008; */
    color: var(--accent-600);
    background-color: var(--accent-50);
    border-radius: 0.5rem;
    padding: 0.5rem;
    font-family: 'Montagu Slab', serif;
    font-size: 1.5em;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .hero--intro-bee {
    width: 2em;
    height: 2em;
  }
  .hero--intro-bee:first-child {
    transform: scaleX(-1);
  }
  .hero--intro:hover .hero--intro-bee {
    animation: wiggle-cw 1s infinite;
  }
  .hero--intro:hover .hero--intro-bee:first-child {
    animation: wiggle-ccw 1s infinite;
  }
  .hero {
    transition: scale 300ms, filter 300ms;
    overflow: clip;
    position: relative;
    border-radius: 0.5rem;
    color: var(--background);
    max-width: 100%;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    grid-template-rows: 1fr auto;
    grid-template-areas:
      "image title"
      "content content";
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    /* filter: drop-shadow(0 0.5rem 0.5rem #000b); */
    border: 1px solid var(--foreground);
  }
  .hero>* {
    z-index: 1;
  }
  .hero--background-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero--foreground-image {
    grid-area: image;
    width: 100%;
    height: auto;
  }
  .hero--title {
    grid-area: title;
    font-family: 'Montagu Slab', serif;
    font-size: 1.5em;
    font-weight: 600;
    text-shadow: 2px 0 var(--foreground), -2px 0 var(--foreground), 0 2px var(--foreground), 0 -2px var(--foreground), 1px 1px var(--foreground), -1px -1px var(--foreground), 1px -1px var(--foreground), -1px 1px var(--foreground);
    text-wrap: balance;
  }
  .hero--content {
    grid-area: content;
    border-radius: 0.5rem;
    background-color: #000a;
    align-self: stretch;
    padding-inline: 1rem;
  }
  .hero--call-to-action {
    transition: background-color 300ms;
    display: block;
    width: fit-content;
    float: inline-end;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 500;
    padding: 0.5rem;
    background-color: var(--accent-600);
    color: var(--accent-50);
    border-radius: 0.5rem;
    margin-block: 1rem;
  }
  .hero--call-to-action::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .hero--call-to-action:hover {
    background-color: var(--accent-500);
  }
  .hero:has(.hero--call-to-action:hover) {
    scale: 1.025;
    filter: drop-shadow(0 0.5rem 1rem #000b);
  }
  @media (min-width: 576px) {
    .hero {
      grid-template-columns: 1fr 3fr;
    }
    .hero--title {
      font-size: 2rem;
    }
    .hero--content {
      font-size: 1.25rem;
    }
    .hero--call-to-action {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 768px) {
    .hero--title {
      font-size: 2.75rem;
    }
  }
</style>
<div class="hexes hero--wrapper">
  <div class="container--md">
    <div class="hero--intro">
      <picture>
        <img src="/bee.svg" alt="" class="hero--intro-bee" />
      </picture>
      What's the buzz?
      <picture>
        <img src="/bee.svg" alt="" class="hero--intro-bee" />
      </picture>
    </div>
    <div class="hero">
      <picture>
        <img src="{{ hero.background }}" alt="" class="hero--background-image" />
      </picture>
      <picture>
        <img src="/logo.png" alt="" class="hero--foreground-image" />
      </picture>
      <div class="hero--title">{{ hero.title }}</div>
      <div class="hero--content">
          {{ hero.body | markdown }}
          <a class="hero--call-to-action" href="{{ hero.link }}">{{ hero.cta }}</a>
        </p>
      </div>
    </div>
  </div>
</div>
<div class="container--xl">
  <h1>Apalachee Beekeepers Association Welcomes You!</h1>
  <p>Serving the Beekeeping Community in Northern Florida & Southern Georgia</p>
  {%- assign eventlist = collections.events | futureOnly -%}
  {% if eventlist.length != 0 %}
  <h2>Upcoming Events</h2>
  {% include 'eventlist' %}
  {% endif %}
</div>
